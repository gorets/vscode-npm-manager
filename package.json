{
  "name": "vscode-npm-manager",
  "displayName": "NPM Manager",
  "description": "Context menu for running NPM commands on package.json files",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-npm-manager.npmInstall",
        "title": "NPM Install"
      },
      {
        "command": "vscode-npm-manager.npmRun",
        "title": "NPM Run..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == package.json",
          "command": "vscode-npm-manager.npmInstall",
          "group": "npm@1"
        },
        {
          "when": "resourceFilename == package.json",
          "command": "vscode-npm-manager.npmRun",
          "group": "npm@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vscode-npm-manager.git"
  },
  "keywords": [
    "npm",
    "package.json",
    "context-menu",
    "npm-scripts"
  ],
  "license": "MIT"
}
