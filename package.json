{
  "name": "vscode-npm-manager",
  "displayName": "Npm Manager",
  "description": "Context menu for running Npm commands on package.json files",
  "version": "0.0.1",
  "publisher": "Vladimir Gorobets",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-npm-manager.npmInstall",
        "title": "Npm Install"
      },
      {
        "command": "vscode-npm-manager.npmUpdate",
        "title": "Npm Update"
      },
      {
        "command": "vscode-npm-manager.npmOutdated",
        "title": "Npm Outdated"
      },
      {
        "command": "vscode-npm-manager.npmAudit",
        "title": "Npm Audit"
      },
      {
        "command": "vscode-npm-manager.npmAuditFix",
        "title": "Npm Audit Fix"
      },
      {
        "command": "vscode-npm-manager.npmCI",
        "title": "Npm CI"
      },
      {
        "command": "vscode-npm-manager.npmTest",
        "title": "Npm Test"
      },
      {
        "command": "vscode-npm-manager.npmRun",
        "title": "Npm Run..."
      },
      {
        "command": "vscode-npm-manager.npmCacheClean",
        "title": "Npm Cache Clean"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == package.json",
          "submenu": "vscode-npm-manager.commands",
          "group": "npm@1"
        }
      ],
      "vscode-npm-manager.commands": [
        {
          "command": "vscode-npm-manager.npmInstall",
          "group": "1_basic@1"
        },
        {
          "command": "vscode-npm-manager.npmUpdate",
          "group": "1_basic@2"
        },
        {
          "command": "vscode-npm-manager.npmCI",
          "group": "1_basic@3"
        },
        {
          "command": "vscode-npm-manager.npmTest",
          "group": "2_test@1"
        },
        {
          "command": "vscode-npm-manager.npmRun",
          "group": "2_test@2"
        },
        {
          "command": "vscode-npm-manager.npmOutdated",
          "group": "3_maintenance@1"
        },
        {
          "command": "vscode-npm-manager.npmAudit",
          "group": "3_maintenance@2"
        },
        {
          "command": "vscode-npm-manager.npmAuditFix",
          "group": "3_maintenance@3"
        },
        {
          "command": "vscode-npm-manager.npmCacheClean",
          "group": "3_maintenance@4"
        }
      ]
    },
    "submenus": [
      {
        "id": "vscode-npm-manager.commands",
        "label": "Npm Commands"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gorets/vscode-npm-manager.git"
  },
  "keywords": [
    "npm",
    "package.json",
    "context-menu",
    "npm-scripts"
  ],
  "license": "MIT"
}
